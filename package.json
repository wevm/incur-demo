{
  "name": "@wevm/incur-demo",
  "version": "0.0.1",
  "description": "A small Incur CLI with standalone binary releases.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/incur-demo"
  },
  "scripts": {
    "build": "incur build ./src/bin.ts --installer",
    "check:types": "tsc --noEmit",
    "changeset": "changeset",
    "dev": "tsx src/bin.ts",
    "release": "pnpm run check:types && pnpm test && changeset publish",
    "test": "vitest run",
    "version": "changeset version"
  },
  "dependencies": {
    "incur": "^0.4.22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "bun": "1.3.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bun"
    ]
  }
}
