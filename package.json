{
  "scripts": {
    "build": "zile",
    "build:binaries": "incur build ./src/bin.ts --installer",
    "check:types": "tsc --noEmit",
    "changeset": "changeset",
    "dev": "tsx src/bin.ts",
    "release": "zile publish:prepare && changeset publish && zile publish:post",
    "test": "vitest run src",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "bun": "1.3.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zile": "0.0.30"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bun"
    ]
  },
  "[!start-pkg]": "",
  "name": "incur-demo",
  "version": "0.0.2",
  "description": "A small Incur CLI with npm and standalone binary releases.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/incur-demo"
  },
  "bin": {
    "incur-demo": "./dist/bin.js",
    "incur-demo.src": "./src/bin.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "dependencies": {
    "incur": "^0.4.22"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {}
}
