{
  "name": "@wevm/incur-demo",
  "version": "0.0.0",
  "description": "A small Incur CLI with npm and standalone binary releases.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/incur-demo"
  },
  "bin": {
    "incur-demo": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --format=esm --outfile=dist/bin.js --packages=external --platform=node --target=node22",
    "check": "npm run check:types && npm test && npm run build",
    "check:types": "tsc --noEmit",
    "changeset": "changeset",
    "dev": "tsx src/bin.ts",
    "prepack": "npm run build",
    "release": "npm run check && changeset publish",
    "test": "vitest run",
    "version": "changeset version"
  },
  "dependencies": {
    "incur": "^0.4.21"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "bun": "^1.3.14",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
